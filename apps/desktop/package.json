{
  "name": "koushi-desktop",
  "version": "0.6.0",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "description": "Koushi — a desktop Matrix client.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:tauri": "vite --host 127.0.0.1 --mode tauri",
    "guard:sdk": "node ../../scripts/check-sdk-submodule.mjs",
    "build": "tsc --noEmit && vite build",
    "build:dmg": "node ../../scripts/desktop-build-dmg.mjs",
    "build:dmg:signed": "node ../../scripts/desktop-build-dmg.mjs --signed",
    "build:windows": "node ../../scripts/desktop-build-windows.mjs",
    "build:linux": "node ../../scripts/desktop-build-linux.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "qa:mac-gui": "node ../../scripts/desktop-mac-gui-smoke.mjs --run",
    "qa:linux-gui": "node ../../scripts/desktop-linux-gui-qa.mjs --run",
    "qa:headless-local": "node ../../scripts/desktop-headless-local-qa.mjs --run",
    "qa:headless-invites:tuwunel": "node ../../scripts/desktop-headless-local-qa.mjs --run --server=tuwunel --core --scenario=invites_dm --timeout-ms=240000",
    "qa:headless-invites:synapse": "node ../../scripts/desktop-headless-local-qa.mjs --run --server=synapse --core --scenario=invites_dm --timeout-ms=240000",
    "qa:headless-core": "node ../../scripts/desktop-headless-local-qa.mjs --run --server=both --core --scenario=login_sync,directory,timeline_reconnect,send_queue --timeout-ms=600000 --cargo-profile=release",
    "qa:headless-basic:local": "node ../../scripts/desktop-headless-local-qa.mjs --run --server=both --core --scenario=login_sync,directory,timeline_reconnect,send_queue --timeout-ms=600000 --cargo-profile=release",
    "qa:headless-basic:real": "node ../../scripts/desktop-real-homeserver-qa.mjs --run --scenario=space_compat",
    "qa:manual": "node ../../scripts/desktop-manual-qa.mjs --markdown",
    "qa:real-account": "cargo run -p koushi-sdk --features smoke --bin password-login-smoke -- --real-account-qa",
    "qa:real-homeserver": "node ../../scripts/desktop-real-homeserver-qa.mjs --run",
    "release:preflight": "node ../../scripts/desktop-release-preflight.mjs --check-config",
    "release:preflight:macos-signing": "node ../../scripts/desktop-release-preflight.mjs --macos-signing",
    "release:preflight:strict": "node ../../scripts/desktop-release-preflight.mjs --strict-signing",
    "release:version:check": "node ../../scripts/desktop-release-version.mjs",
    "lint": "eslint src && node ../../scripts/check-ime-text-inputs.mjs && node ../../scripts/check-agents-docs.mjs && node ../../scripts/check-frontend-semantic-owners.mjs",
    "lint:tauri-boundary": "node ../../scripts/check-tauri-adapter-boundary.mjs && node ../../scripts/check-command-snapshot-contract.mjs",
    "lint:domain-deps": "node ../../scripts/check-domain-crate-platform-deps.mjs && node ../../scripts/check-leaf-crate-boundaries.mjs",
    "lint:rust-test-structure": "node ../../scripts/check-rust-test-structure.mjs",
    "test": "vitest run",
    "test:ipc-contract": "cargo test -p koushi-desktop core_event_wire_format_matches_checked_in_contract_artifact",
    "test:ui-headless": "vitest run --reporter=verbose src/domain/timelineStore.test.ts && playwright test",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "qa:secret-scan": "node ../../scripts/desktop-secret-scan.mjs",
    "qa:wasm-check": "cargo check --target wasm32-unknown-unknown -p koushi-state -p koushi-search -p koushi-protocol",
    "qa:release-gates": "node ../../scripts/desktop-release-gate-check.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@matrix-org/emojibase-bindings": "^1.5.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "katex": "^0.18.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "twemoji-colr-font": "15.0.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@puppeteer/browsers": "file:./puppeteer-browsers-2.13.3.tgz",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "webdriverio": "9.28.0"
  },
  "overrides": {
    "@puppeteer/browsers": "$@puppeteer/browsers",
    "deepmerge-ts": "8.0.1"
  }
}
